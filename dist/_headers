# Same-origin scripts with exact hashes; MathJax CHTML needs dynamic inline styles.
# No blanket inline-script permission. Public pages and mutable assets revalidate.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-0deQiRNXMHoit0vLPzMc3Nq6LedkIvK6JUL6YNc07r8=' 'sha256-j48zkK41IxUYKaL3cLF9VkAH0pEn3gs0fJih3zenVLM='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'
  Cache-Control: public, max-age=0, must-revalidate
